# Application
NEXT_PUBLIC_APP_URL=https://apsicsmedia.com

# Email Configuration (Optional - for alternative email service)
RESEND_API_KEY=your_resend_api_key_here
RESEND_AUDIENCE_ID=your_resend_audience_id_here
NEXT_PUBLIC_FROM_EMAIL=mondaymorningmarketer@gmail.com

# ConvertKit Configuration (Required for email signups)
CONVERTKIT_API_KEY=your_convertkit_api_key_here
CONVERTKIT_FORM_ID=your_convertkit_form_id_here

# Stripe Configuration (Required for payments)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
NEXT_PUBLIC_STRIPE_URL=https://buy.stripe.com/your-payment-link-here

# Calendly Configuration (Optional)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-username

# Airtable Configuration (Optional - for lead management)
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_NAME="Lead Management"

# Analytics (Required for tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_google_analytics_id_here

# OpenRouter API Configuration (Required for AI tools - SERVER SIDE ONLY)
OPENROUTER_API_KEY=your_openrouter_api_key_here