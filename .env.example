# Reddit API Credentials
# Get these from https://www.reddit.com/prefs/apps after creating a script app

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=YourApp:outreach:v1.0

# Reddit username and password for authenticated requests (required for posting)
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# Optional: Perplexity API (used in research workflows)
PERPLEXITY_API_KEY=your_perplexity_api_key_here
