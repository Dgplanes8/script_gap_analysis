# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Reddit API Configuration
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USERNAME=your_reddit_username_here
REDDIT_PASSWORD=your_reddit_password_here
REDDIT_USER_AGENT=ApsicsMedia:outreach:v1.0 (by /u/yourusername)

# Optional: ProfitOutreach API (100 free credits)
PROFITOUTREACH_API_KEY=your_profitoutreach_api_key_here

# Optional: Email configuration for notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Safety & Compliance Settings
RATE_LIMIT_TWITTER=60  # requests per hour
RATE_LIMIT_LINKEDIN=50  # actions per hour
RATE_LIMIT_REDDIT=100  # requests per hour
DEBUG_MODE=true
DRY_RUN=true  # Set to false for live automation