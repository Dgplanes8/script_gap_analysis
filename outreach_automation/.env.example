# Airtable Configuration - Get from https://airtable.com/account
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXXX

# Reddit API Configuration - Get from https://www.reddit.com/prefs/apps  
REDDIT_CLIENT_ID=XXXXXXXXXXXXXXXXXX
REDDIT_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
REDDIT_USERNAME=your_secure_reddit_username
REDDIT_PASSWORD=your_secure_reddit_password_with_2fa_enabled
REDDIT_USER_AGENT=YourSecureApp:outreach:v1.0 (by /u/yourusername)

# Optional: ProfitOutreach API (100 free credits)
PROFITOUTREACH_API_KEY=your_profitoutreach_api_key_here

# Optional: Email configuration for notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here

# Safety & Compliance Settings
RATE_LIMIT_TWITTER=60  # requests per hour
RATE_LIMIT_LINKEDIN=50  # actions per hour
RATE_LIMIT_REDDIT=100  # requests per hour
DEBUG_MODE=true
DRY_RUN=true  # Set to false for live automation